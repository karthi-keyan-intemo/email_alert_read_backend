DATABASE_URL=postgresql://postgres:postgres@localhost:5432/email_alert_reader
EMAIL=your-email@example.com
APP_PASSWORD=your-app-password
GMAIL_FOLDER=INBOX
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
N8N_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Application cron: runs the email alert sync inside the backend app.
# Set CRON_ENABLED=true to turn it on. Runs daily at CRON_SCHEDULE (5-field
# cron expression, evaluated in CRON_TIMEZONE) and syncs from
# today - CRON_LOOKBACK_DAYS to today. "30 4 * * *" in Asia/Kolkata = 10:00 AM IST.
CRON_ENABLED=false
CRON_SCHEDULE=30 4 * * *
CRON_TIMEZONE=Asia/Kolkata
CRON_LOOKBACK_DAYS=1
